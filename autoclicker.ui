   <string notr="true">
QMainWindow {
    background-color: #1e1f26;
}
QWidget {
    color: #e7e7ec;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}
QLabel#titleLabel {
    font-size: 26px;
    font-weight: 700;
    color: #ffffff;
}
QLabel#subtitleLabel {
    color: #9a9aab;
    font-size: 12px;
}
QLabel#countdownLabel {
    font-size: 40px;
    font-weight: 700;
    color: #7c5cff;
}
QLabel#statusLabel {
    color: #9a9aab;
    font-size: 12px;
}
QGroupBox {
    background-color: #2a2b35;
    border: 1px solid #3a3b47;
    border-radius: 10px;
    margin-top: 14px;
    font-weight: 600;
    font-size: 13px;
    padding-top: 6px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 2px 8px;
    color: #c9c9ff;
    background-color: #2a2b35;
}
QCheckBox, QRadioButton {
    spacing: 8px;
    padding: 2px;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
}
QDoubleSpinBox {
    background-color: #1e1f26;
    border: 1px solid #3a3b47;
    border-radius: 6px;
    padding: 4px 6px;
    min-width: 70px;
}
QPushButton {
    border-radius: 8px;
    padding: 10px 18px;
    font-weight: 600;
    font-size: 13px;
}
QPushButton#startButton {
    background-color: #7c5cff;
    color: #ffffff;
    border: none;
}
QPushButton#startButton:hover {
    background-color: #8d70ff;
}
QPushButton#startButton:disabled {
    background-color: #3a3b47;
    color: #777;
}
QPushButton#stopButton {
    background-color: #ff5c7c;
    color: #ffffff;
    border: none;
}
QPushButton#stopButton:hover {
    background-color: #ff7590;
}
QPushButton#stopButton:disabled {
    background-color: #3a3b47;
    color: #777;
}
QTextEdit {
    background-color: #16171d;
    border: 1px solid #3a3b47;
    border-radius: 8px;
    color: #b8ffcb;
    font-family: Consolas, monospace;
    font-size: 12px;
}
QScrollBar:vertical {
    background: #1e1f26;
    width: 10px;
}
QScrollBar::handle:vertical {
    background: #3a3b47;
    border-radius: 5px;
}
</string>
